{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "aislop",
  "description": "CLI quality gate for AI generated code. Scan, score, and fix slop across 10 language targets. Deterministic, no LLM at runtime.",
  "colors": {
    "primary": "#10b981",
    "light": "#34d399",
    "dark": "#059669"
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "https://scanaislop.com"
  },
  "favicon": "/assets/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Inter"
    },
    "body": {
      "family": "Inter"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/assets/og-image.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://scanaislop.com"
      },
      {
        "label": "npm",
        "href": "https://www.npmjs.com/package/aislop"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/scanaislop/aislop"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/scanaislop/aislop",
      "x": "https://x.com/scanaislop",
      "discord": "https://discord.gg/Mzz4A6mfj6"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Website",
            "href": "https://scanaislop.com"
          },
          {
            "label": "Pricing",
            "href": "https://scanaislop.com/pricing"
          },
          {
            "label": "CLI on GitHub",
            "href": "https://github.com/scanaislop/aislop"
          },
          {
            "label": "npm",
            "href": "https://www.npmjs.com/package/aislop"
          }
        ]
      },
      {
        "header": "Docs",
        "items": [
          {
            "label": "Quickstart",
            "href": "/quickstart"
          },
          {
            "label": "Installation",
            "href": "/installation"
          },
          {
            "label": "Scoring",
            "href": "/concepts/scoring"
          },
          {
            "label": "Changelog",
            "href": "/reference/changelog"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/"
    }
  ],
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "installation"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/how-it-works",
          "concepts/scoring",
          "concepts/rules",
          "concepts/supported-languages"
        ]
      },
      {
        "group": "CLI",
        "pages": [
          "cli/commands",
          "cli/scan",
          "cli/agent",
          "cli/fix",
          "cli/ci",
          "cli/init",
          "cli/doctor",
          "cli/rules",
          "cli/hooks",
          "cli/badge",
          "cli/trend",
          "cli/update-version"
        ]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/github-actions",
          "integrations/instant-scan",
          "integrations/pre-commit",
          "integrations/ci-cd",
          "integrations/agent-skill",
          "integrations/mcp-server",

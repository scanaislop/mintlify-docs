{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "aislop",
  "description": "CLI quality gate for AI generated code. Scan, score, and fix slop across 10 language targets. Deterministic, no LLM at runtime.",
  "colors": {
    "primary": "#047857",
    "light": "#10b981",
    "dark": "#047857"
  },
  "background": {
    "color": {
      "light": "#fafaf9",
      "dark": "#08090a"
    }
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "https://scanaislop.com"
  },
  "favicon": "/assets/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Mona Sans",
      "source": "/fonts/mona-sans.woff2",
      "format": "woff2",
      "weight": 600
    },
    "body": {
      "family": "Mona Sans",
      "source": "/fonts/mona-sans.woff2",
      "format": "woff2"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "vesper"
      }
    }
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/assets/og-image.png"
  },
  "search": {
    "prompt": "Search commands, rules, flags..."
  },
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "https://scanaislop.com/pricing"
      },
      {
        "type": "github",
        "label": "GitHub",
        "href": "https://github.com/scanaislop/aislop"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Scan a repo",
      "href": "https://scanaislop.com/try/"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/scanaislop/aislop",
      "x": "https://x.com/scanaislop",
      "discord": "https://discord.gg/Mzz4A6mfj6"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Website",
            "href": "https://scanaislop.com"
          },
          {
            "label": "Pricing",
            "href": "https://scanaislop.com/pricing"
          },
          {
            "label": "CLI on GitHub",
            "href": "https://github.com/scanaislop/aislop"
          },
          {
            "label": "npm",
            "href": "https://www.npmjs.com/package/aislop"
          }
        ]
      },
      {
        "header": "Docs",
        "items": [
          {
            "label": "Quickstart",
            "href": "/quickstart"
          },
          {
            "label": "Installation",
            "href": "/installation"
          },
          {
            "label": "Scoring",
            "href": "/concepts/scoring"
          },
          {
            "label": "For agents",
            "href": "/agents"
          },
          {
            "label": "Changelog",
            "href": "/reference/changelog"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/"
    },
    {
      "source": "/for-agents",
      "destination": "/agents"
    }
  ],
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Get started",
            "icon": "rocket",
            "groups": [
              {
                "group": "Get started",
                "icon": "flag",
                "pages": [
                  "index",
                  "quickstart",
                  "installation",
                  "agents"
                ]
              },
              {
                "group": "Concepts",
                "icon": "lightbulb",
                "pages": [
                  "concepts/how-it-works",
                  "concepts/scoring",
                  "concepts/rules",
                  "concepts/supported-languages"
                ]
              },
              {
                "group": "Guides",
                "icon": "book-open",
                "pages": [
                  "guides/writing-comments"
                ]
              }
            ]
          },
          {
            "tab": "CLI",
            "icon": "terminal",
            "groups": [
              {
                "group": "Overview",
                "icon": "list",
                "pages": [
                  "cli/commands"
                ]
              },
              {
                "group": "Core commands",
                "icon": "play",
                "pages": [
                  "cli/scan",
                  "cli/fix",
                  "cli/agent",
                  "cli/ci",
                  "cli/init"
                ]
              },
              {
                "group": "Utilities",
                "icon": "wrench",
                "pages": [
                  "cli/doctor",
                  "cli/rules",
                  "cli/hooks",
                  "cli/badge",
                  "cli/trend",
                  "cli/update-version"
                ]
              }
            ]
          },
          {
            "tab": "Integrations",
            "icon": "plug",
            "groups": [
              {
                "group": "CI and Git",
                "icon": "code-branch",
                "pages": [
                  "integrations/github-actions",
                  "integrations/ci-cd",
                  "integrations/pre-commit",
                  "integrations/instant-scan"
                ]
              },
              {
                "group": "Agents and editors",
                "icon": "robot",
                "pages": [
                  "integrations/agent-skill",
                  "integrations/mcp-server",
                  "integrations/vscode"
                ]
              }
            ]
          },
          {
            "tab": "Configuration",
            "icon": "sliders",
            "groups": [
              {
                "group": "Configuration",
                "icon": "gear",
                "pages": [
                  "configuration/config-file",
                  "configuration/example-configs",
                  "configuration/engines",
                  "configuration/rule-overrides",
                  "configuration/architecture-rules",
                  "configuration/ignoring-code"
                ]
              }
            ]
          },
          {
            "tab": "Reference",
            "icon": "book",
            "groups": [
              {
                "group": "Reference",
                "icon": "bookmark",
                "pages": [
                  "reference/rules-reference",
                  "reference/config-schema",
                  "reference/changelog",
                  "reference/telemetry"
                ]
              },
              {
                "group": "Operations",
                "icon": "server",
                "pages": [
                  "reference/research-program",
                  "reference/oss-benchmarking",
                  "reference/github-marketplace-action",
                  "reference/release-checklist",
                  "reference/fix-to-pr"
                ]
              }
            ]
          }
        ]
      },

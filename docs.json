{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "aislop",
  "description": "CLI quality gate for AI generated code. Scan, score, and fix slop across 10 language targets. Deterministic, no LLM at runtime.",
  "colors": {
    "primary": "#059669",
    "light": "#10b981",
    "dark": "#047857"
  },
  "background": {
    "color": {
      "light": "#fafaf9",
      "dark": "#08090a"
    }
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "https://scanaislop.com"
  },
  "favicon": "/assets/favicon.svg",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "heading": {
      "family": "Mona Sans",
      "source": "/fonts/mona-sans.woff2",
      "format": "woff2",
      "weight": 600
    },
    "body": {
      "family": "Mona Sans",
      "source": "/fonts/mona-sans.woff2",
      "format": "woff2"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light-default",
        "dark": "vesper"
      }
    }
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/assets/og-image.png"
  },
  "search": {
    "prompt": "Search commands, rules, flags..."
  },
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "https://scanaislop.com/pricing"
      },
      {
        "type": "github",
        "label": "GitHub",
        "href": "https://github.com/scanaislop/aislop"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Scan a repo",
      "href": "https://scanaislop.com/try/"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/scanaislop/aislop",
      "x": "https://x.com/scanaislop",
      "discord": "https://discord.gg/Mzz4A6mfj6"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Website",
            "href": "https://scanaislop.com"
          },
          {
            "label": "Pricing",
            "href": "https://scanaislop.com/pricing"
          },
          {
            "label": "CLI on GitHub",
            "href": "https://github.com/scanaislop/aislop"
          },
          {
            "label": "npm",
            "href": "https://www.npmjs.com/package/aislop"
          }
        ]
      },
      {
        "header": "Docs",
        "items": [
          {
            "label": "Quickstart",
            "href": "/quickstart"
          },
          {
            "label": "Installation",
            "href": "/installation"
          },
          {
            "label": "Scoring",
            "href": "/concepts/scoring"
          },
          {
            "label": "For agents",
            "href": "/agents"
          },
          {
            "label": "Changelog",
            "href": "/reference/changelog"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/introduction",
      "destination": "/"
    },
    {
      "source": "/for-agents",
      "destination": "/agents"
    }
  ],
